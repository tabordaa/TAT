# Copy this file to .env and fill in real values. NEVER commit .env.

ENVIRONMENT=development

# Supabase -> Connect -> Session pooler.
# 1) Change the scheme "postgresql://" to "postgresql+psycopg://"
# 2) If your password has special characters (@ : / # ? %), URL-encode them.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<pooler-host>.pooler.supabase.com:5432/postgres

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=<at-least-32-random-characters>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# JSON list of allowed frontend origins (no "*" when credentials are enabled).
CORS_ORIGINS=["http://localhost:5173"]

COOKIE_NAME=tat_access_token
# true in production (HTTPS only); the API refuses to start otherwise
COOKIE_SECURE=false

# How many of our reverse proxies sit in front of the API. 0 locally.
# Decides which X-Forwarded-For entry is trusted as the client's IP.
TRUSTED_PROXY_HOPS=0

# Login brute-force limits (optional, these are the defaults)
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_IP=30
LOGIN_FAILURE_WINDOW_SECONDS=900

# Profile photos, in a PRIVATE Supabase Storage bucket. Without them the API still
# starts and only the photo endpoints answer 503.
# Check the setup with: python -m scripts.check_storage
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_STORAGE_BUCKET=employee-photos
